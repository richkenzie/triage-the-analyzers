<?xml version="1.0" encoding="UTF-8"?>
<!-- PMD rules for Project Pulse: PMD's quickstart set, minus the rules the team has decided not to
     enforce. To drop a rule, add an exclude inside the quickstart reference, with a comment giving
     the reason, for example:

       <exclude name="ControlStatementBraces"/>

     To add a rule from outside quickstart, add its own <rule ref="category/java/..."/> line.
     Every change here is a reviewed decision. -->
<ruleset name="Project Pulse"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    <description>PMD quickstart, with Project Pulse's decisions.</description>
    <rule ref="rulesets/java/quickstart.xml">
     <!-- D2: re-added below, narrowed to non-entity classes -->
        <exclude name="UncommentedEmptyConstructor"/>
        <exclude name="UnnecessaryConstructor"/>
        <!--
          D4 (off): GuardLogStatement. Project Pulse logs through SLF4J with {} placeholders,
          so the message is only formatted when the level is enabled; a guard saves only the
          argument evaluation. All 4 flagged calls pass simple getters or size()
          (ReminderService, WeeklyReminderScheduler, DocumentTemplateRegistry, AuthController),
          so a guard adds an if-block per call for no measurable gain. Guard by hand any
          argument that is expensive to compute.
        -->
        <exclude name="GuardLogStatement"/>
    </rule>

     <!--
      D2 (narrow): UncommentedEmptyConstructor and UnnecessaryConstructor are off for
      @Entity classes and enforced everywhere else.
      Reason: JPA requires every entity to have a no-argument constructor. 25 of the 29
      flagged classes are entities, and their empty constructors exist for that reason.
      Removing one where it is the only constructor works today, but the first added
      constructor with arguments would make Hibernate fail at runtime, not at compile time.
      The 4 flagged non-entity classes (PeerEvaluationAverage, RatingAverage,
      WeeklyPeerEvaluationReport, Result) had unused empty constructors, now removed.
    -->
    <rule ref="category/java/documentation.xml/UncommentedEmptyConstructor">
        <properties>
            <property name="violationSuppressXPath"
                      value="./ancestor-or-self::ClassDeclaration[pmd-java:hasAnnotation('jakarta.persistence.Entity')]"/>
        </properties>
    </rule>
    <rule ref="category/java/codestyle.xml/UnnecessaryConstructor">
        <properties>
            <property name="violationSuppressXPath"
                      value="./ancestor-or-self::ClassDeclaration[pmd-java:hasAnnotation('jakarta.persistence.Entity')]"/>
        </properties>
    </rule>
</ruleset>
